<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<DialogPane prefWidth="360.0" styleClass="dialog-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplayer.ui.NewPlaylistController">
   <content>
      <VBox spacing="14.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="dialog-title" text="Nuova Playlist" />
                  <Label styleClass="small-label" text="Dai un nome alla playlist. I duplicati vengono bloccati automaticamente." />
               </children>
            </VBox>
            <Label styleClass="form-label" text="Nome playlist" />
            <TextField fx:id="txtNomePlaylist" promptText="Nome playlist..." />
         </children>
      </VBox>
   </content>
   <buttonTypes>
      <ButtonType fx:constant="OK" />
      <ButtonType fx:constant="CANCEL" />
   </buttonTypes>
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
</DialogPane>
