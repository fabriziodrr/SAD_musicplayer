<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>

<BorderPane minHeight="540.0" minWidth="820.0" prefHeight="700.0" prefWidth="1120.0" styleClass="app-shell" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplayer.ui.PrimaryController">
   <padding>
      <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
   </padding>

   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="4.0" styleClass="nav-switcher">
               <children>
                  <Button fx:id="btnNavHome" mnemonicParsing="false" styleClass="nav-button, nav-button-active" text="Catalogo" />
                  <Button fx:id="btnNavStats" mnemonicParsing="false" styleClass="nav-button" text="Statistiche" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
             <Button fx:id="undoButton" mnemonicParsing="false" styleClass="pill-button" text="Annulla" />
         </children>
      </HBox>
   </top>

   <left>
      <VBox minWidth="170.0" prefWidth="230.0" spacing="14.0" styleClass="surface, playlist-sidebar" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label styleClass="section-subtitle" text="PLAYLIST" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="createNewPlaylistButton" mnemonicParsing="false" styleClass="icon-button" text="+" />
                   <Button fx:id="btnGeneraPlaylistAuto" mnemonicParsing="false" styleClass="icon-button" text="&#x26A1;" />
               </children>
            </HBox>
            <ListView fx:id="sidebarListView" VBox.vgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </left>

   <center>
      <TabPane fx:id="mainTabPane" style="-fx-background-color: transparent; -fx-tab-max-height: 0; -fx-tab-min-height: 0; -fx-padding: 0; -fx-background-insets: 0; -fx-box-border: transparent; -fx-tab-header-background: transparent;" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab text="HomeCatalog">
               <content>
                  <VBox spacing="18.0" styleClass="surface">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                           <children>
                               <Button fx:id="mainPlaylistPlayButton" maxHeight="42.0" maxWidth="42.0" minHeight="42.0" minWidth="42.0" mnemonicParsing="false" styleClass="play-button" text="&#x25B6;" />
                              <VBox spacing="3.0">
                                 <children>
                                    <Label fx:id="catalogTitleLabel" styleClass="section-title" text="Catalogo Globale" />
                                    <Label styleClass="small-label" text="Gestisci brani, playlist e dettagli del catalogo" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                               <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-toolbar">
                                  <children>
                                     <Button fx:id="btnOpenMockDialog" mnemonicParsing="false" styleClass="action-button, action-button-primary" text="♪ Brano" />
                                      <Button fx:id="btnAddToPlaylist" mnemonicParsing="false" styleClass="action-button, action-button-secondary" text="+ Playlist" />
                                      <Button fx:id="btnEditTrack" mnemonicParsing="false" styleClass="action-button, action-button-secondary" text="&#x270E; Modifica" />
                                      <Button fx:id="btnSpostaSu" mnemonicParsing="false" 
                                       styleClass="action-button, action-button-secondary" text="&#x25B2;" />
                                      <Button fx:id="btnSpostaGiu" mnemonicParsing="false" 
                                       styleClass="action-button, action-button-secondary" text="&#x25BC;" />
                                      <Button fx:id="btnRemoveTrack" mnemonicParsing="false" styleClass="action-button, action-button-danger" text="&#x2715; Rimuovi" />
                                  </children>
                               </HBox>
                           </children>
                        </HBox>

                        <!-- Modalità di riproduzione del catalogo o della playlist visualizzata -->
                        <HBox fx:id="playlistModeControls"
                              alignment="CENTER_LEFT"
                              managed="true"
                              spacing="10.0"
                              styleClass="mode-row"
                              visible="true">

                            <children>
                               <Label styleClass="mode-label" text="Riproduzione" />
                               <HBox alignment="CENTER_LEFT" spacing="0.0" styleClass="mode-switcher">
                                  <children>
                               <ToggleButton fx:id="btnPlaylistSequenziale"
                                             accessibleText="Modalità sequenziale"
                                             maxHeight="34.0"
                                             minHeight="34.0"
                                             mnemonicParsing="false"
                                             prefHeight="34.0"
                                             prefWidth="104.0"
                                             styleClass="player-control-button, playlist-mode-button"
                                              text="&#x2192; Sequenza">
                                 <tooltip>
                                    <Tooltip text="Sequenziale" />
                                 </tooltip>
                              </ToggleButton>

                               <ToggleButton fx:id="btnPlaylistLoop"
                                             accessibleText="Modalità loop"
                                             maxHeight="34.0"
                                             minHeight="34.0"
                                             mnemonicParsing="false"
                                             prefHeight="34.0"
                                             prefWidth="82.0"
                                             styleClass="player-control-button, playlist-mode-button"
                                              text="&#x21BB; Loop">
                                 <tooltip>
                                    <Tooltip text="Loop" />
                                 </tooltip>
                              </ToggleButton>

                               <ToggleButton fx:id="btnPlaylistShuffle"
                                             accessibleText="Modalità shuffle"
                                             maxHeight="34.0"
                                             minHeight="34.0"
                                             mnemonicParsing="false"
                                             prefHeight="34.0"
                                             prefWidth="90.0"
                                             styleClass="player-control-button, playlist-mode-button"
                                              text="&#x21C4; Shuffle">
                                 <tooltip>
                                    <Tooltip text="Shuffle" />
                                 </tooltip>
                               </ToggleButton>
                                  </children>
                               </HBox>
                            </children>
                         </HBox>

                        <TableView fx:id="songTableView" styleClass="song-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="titleColumn" minWidth="180.0" prefWidth="260.0" text="Titolo" />
                              <TableColumn fx:id="autoreColumn" minWidth="120.0" prefWidth="180.0" text="Artista" />
                              <TableColumn fx:id="genreColumn" minWidth="90.0" prefWidth="140.0" text="Genere" />
                              <TableColumn fx:id="yearColumn" maxWidth="90.0" minWidth="65.0" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Anno" />
                              <TableColumn fx:id="durationColumn" maxWidth="100.0" minWidth="75.0" prefWidth="85.0" style="-fx-alignment: CENTER;" text="Durata" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>

            <Tab text="Stats">
               <content>
                  <VBox spacing="18.0" styleClass="surface">
                     <children>
                        <VBox spacing="3.0">
                           <children>
                              <Label styleClass="section-title" text="Statistiche d'Ascolto" />
                              <Label styleClass="small-label" text="Panoramica dei brani e delle playlist più ascoltate" />
                           </children>
                        </VBox>
                        <GridPane hgap="16.0" vgap="16.0" VBox.vgrow="ALWAYS">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" percentWidth="50.0" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" percentWidth="50.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="120.0" vgrow="ALWAYS" />
                           </rowConstraints>
                           <children>
                              <VBox spacing="10.0" styleClass="surface-soft">
                                 <children>
                                    <Label styleClass="section-subtitle" text="BRANI PIU ASCOLTATI" />
                                    <ListView fx:id="topTracksListView" VBox.vgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                 </padding>
                              </VBox>
                              <VBox spacing="10.0" styleClass="surface-soft" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="section-subtitle" text="PLAYLIST PIU ASCOLTATE" />
                                    <ListView fx:id="topPlaylistsListView" VBox.vgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </GridPane>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
         </tabs>
         <BorderPane.margin>
            <Insets left="12.0" right="12.0" />
         </BorderPane.margin>
      </TabPane>
   </center>

   <right>
   <VBox alignment="CENTER" minWidth="185.0" prefWidth="235.0" spacing="16.0" styleClass="surface" BorderPane.alignment="CENTER">
      <children>
         <!-- Copertina -->
         <ImageView fx:id="copertina" fitHeight="155.0" fitWidth="155.0" preserveRatio="true" visible="false">
   <image>
      <Image url="@/icons/copertina.png" />
   </image>
</ImageView>

         <!-- Nome traccia e autore -->
         <VBox alignment="CENTER" spacing="3.0">
            <children>
               <Label fx:id="currentTrackLabel" alignment="CENTER" maxWidth="190.0" styleClass="current-track-title" text="Seleziona un brano" textOverrun="ELLIPSIS" />
               <Label fx:id="labelAutoreTraccia" styleClass="small-label" text="" />
            </children>
         </VBox>

         <!-- Barra progresso con tempo -->
         <HBox alignment="CENTER" spacing="7.0">
            <children>
               <Label fx:id="labelTempoTrascorso" styleClass="small-label" text="0:00" />
               <ProgressBar fx:id="barraProgresso" prefWidth="120.0" progress="0.0" style="-fx-accent: #1DB954;" HBox.hgrow="ALWAYS" />
               <Label fx:id="labelDurataTotale" styleClass="small-label" text="0:00" />
            </children>
         </HBox>

         <!-- Bottoni player -->
         <HBox alignment="CENTER" spacing="12.0">
            <children>
              <Button fx:id="trackShuffleButton" mnemonicParsing="false" styleClass="player-control-button" text="&#x21C4;" />

               <Button fx:id="btnPrecedente" mnemonicParsing="false" styleClass="player-control-button">
            <graphic>
              <ImageView fitHeight="18.0" fitWidth="18.0" rotate="180.0">
               <image>
                 <Image url="@/icons/skip4.png" />
               </image>
      </ImageView>
   </graphic>
            </Button>
                <Button fx:id="btnPlay" maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" mnemonicParsing="false" styleClass="primary-player-button" text="&#x25B6;" />
               <Button fx:id="btnSkip" mnemonicParsing="false" styleClass="player-control-button">
                 <graphic>
               <ImageView fitHeight="20.0" fitWidth="20.0">
                 <image>
                   <Image url="@/icons/skip4.png" />
                 </image>
               </ImageView>
                 </graphic>
            </Button>
               <Button fx:id="trackLoopButton" mnemonicParsing="false" styleClass="player-control-button" text="&#x21BA;" />
            </children>
         </HBox>
      </children>
      <padding>
         <Insets bottom="20.0" left="14.0" right="14.0" top="20.0" />
      </padding>
   </VBox>
</right>
</BorderPane>
