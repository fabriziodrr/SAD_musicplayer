<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<DialogPane style="-fx-background-color: #121212; -fx-border-color: #282828; -fx-border-radius: 8px; -fx-background-radius: 8px;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplayer.ui.SongDialogController">
   <content>
      <VBox spacing="15.0" style="-fx-background-color: transparent;">
         <children>
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #FFFFFF;" text="Aggiungi Nuovo Brano" />
            
            <GridPane hgap="10.0" vgap="12.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="220.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #B3B3B3; -fx-font-size: 12px;" text="Titolo *" />
                  <TextField fx:id="txtTitle" style="-fx-background-color: #242424; -fx-text-fill: #FFFFFF; -fx-background-radius: 4px; -fx-border-color: #3E3E3E; -fx-border-radius: 4px;" GridPane.columnIndex="1" />
                  
                  <Label style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #B3B3B3; -fx-font-size: 12px;" text="Artista *" GridPane.rowIndex="1" />
                  <TextField fx:id="txtArtist" style="-fx-background-color: #242424; -fx-text-fill: #FFFFFF; -fx-background-radius: 4px; -fx-border-color: #3E3E3E; -fx-border-radius: 4px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #B3B3B3; -fx-font-size: 12px;" text="Durata * (mm:ss)" GridPane.rowIndex="2" />
                  <TextField fx:id="txtDuration" promptText="es. 03:45" style="-fx-background-color: #242424; -fx-text-fill: #FFFFFF; -fx-background-radius: 4px; -fx-border-color: #3E3E3E; -fx-border-radius: 4px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #B3B3B3; -fx-font-size: 12px;" text="Genere *" GridPane.rowIndex="3" />
                  <TextField fx:id="txtGenre" style="-fx-background-color: #242424; -fx-text-fill: #FFFFFF; -fx-background-radius: 4px; -fx-border-color: #3E3E3E; -fx-border-radius: 4px;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <Label style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #B3B3B3; -fx-font-size: 12px;" text="Anno *" GridPane.rowIndex="4" />
                  <TextField fx:id="txtYear" promptText="es. 2026" style="-fx-background-color: #242424; -fx-text-fill: #FFFFFF; -fx-background-radius: 4px; -fx-border-color: #3E3E3E; -fx-border-radius: 4px;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            
            <VBox spacing="8.0" style="-fx-padding: 5 0 0 0;">
               <children>
                  <Label style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #B3B3B3; -fx-font-size: 11px; -fx-font-weight: bold;" text="TAG VISIVI ASSOCIATI" />
                  <HBox spacing="15.0">
                     <children>
                        <CheckBox fx:id="chkExplicit" mnemonicParsing="false" style="-fx-text-fill: #FFFFFF; -fx-font-family: 'Segoe UI'; -fx-font-size: 11px;" text="Esplicito [E]" />
                        <CheckBox fx:id="chkFavorite" mnemonicParsing="false" style="-fx-text-fill: #1DB954; -fx-font-family: 'Segoe UI'; -fx-font-size: 11px;" text="Preferito ★" />
                        <CheckBox fx:id="chkNewRelease" mnemonicParsing="false" style="-fx-text-fill: #00D2FF; -fx-font-family: 'Segoe UI'; -fx-font-size: 11px;" text="Nuova Uscita [NEW]" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
   <buttonTypes>
      <ButtonType fx:constant="OK" />
      <ButtonType fx:constant="CANCEL" />
   </buttonTypes>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</DialogPane>