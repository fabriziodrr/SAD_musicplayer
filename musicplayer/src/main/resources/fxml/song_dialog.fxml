<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<DialogPane prefWidth="430.0" styleClass="dialog-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplayer.ui.SongDialogController">
   <content>
      <VBox spacing="16.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="dialog-title" text="Aggiungi o modifica brano" />
                  <Label styleClass="small-label" text="Compila i dettagli della traccia e scegli eventuali tag visivi." />
               </children>
            </VBox>

            <GridPane hgap="12.0" vgap="12.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="90.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" prefWidth="280.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label styleClass="form-label" text="Titolo *" />
                  <TextField fx:id="txtTitle" GridPane.columnIndex="1" />

                  <Label styleClass="form-label" text="Artista *" GridPane.rowIndex="1" />
                  <TextField fx:id="txtArtist" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label styleClass="form-label" text="Durata *" GridPane.rowIndex="2" />
                  <TextField fx:id="txtDuration" promptText="es. 03:45" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label styleClass="form-label" text="Genere *" GridPane.rowIndex="3" />
                  <TextField fx:id="txtGenre" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <Label styleClass="form-label" text="Anno *" GridPane.rowIndex="4" />
                  <TextField fx:id="txtYear" promptText="es. 2026" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>

            <VBox spacing="9.0">
               <children>
                  <Label styleClass="section-subtitle" text="TAG VISIVI ASSOCIATI" />
                  <HBox spacing="16.0">
                     <children>
                        <CheckBox fx:id="chkExplicit" mnemonicParsing="false" text="Esplicito [E]" />
                        <CheckBox fx:id="chkFavorite" mnemonicParsing="false" text="Preferito ★" />
                        <CheckBox fx:id="chkNewRelease" mnemonicParsing="false" text="Nuova Uscita [NEW]" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
   <buttonTypes>
      <ButtonType fx:constant="OK" />
      <ButtonType fx:constant="CANCEL" />
   </buttonTypes>
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
</DialogPane>
